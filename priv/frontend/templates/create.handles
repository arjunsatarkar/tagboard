<!DOCTYPE html>
<html lang="en">
    <head>
        {{> head_boilerplate . }}
        <title>Create | Tagboard</title>
    </head>
    <body id="app">
        {{> sidebar . }}
        <main>
            <h1>Create</h1>
            <form action="/api/create" method="post">
                <label>
                    URI:
                    <input name="uri" />
                </label>
                <br>
                <label>
                    Tags:
                    <input name="tags_string" />
                </label>
                <br />
                <button>Create</button>
            </form>
        </main>
    </body>
</html>
