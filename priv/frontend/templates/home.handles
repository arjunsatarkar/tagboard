<!DOCTYPE html>
<html lang="en">
    <head>
        {{> head_boilerplate . }}
        <title>Home | Tagboard</title>
    </head>
    <body class="app">
        {{> sidebar . }}
        <main>
            <h1>Tagboard</h1>
            <form action="/api/search">
                <label>
                    Tags:
                    <input name="tags_string" />
                </label>
                <small>(space-separated)</small>
                <br>
                <button>Search</button>
            </form>
        </main>
    </body>
</html>
