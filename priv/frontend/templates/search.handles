<!DOCTYPE html>
<html lang="en">
    <head>
        {{> head_boilerplate . }}
        {{#if tags_param_present}}
            <meta name="robots" content="noindex">
        {{/if}}
        <title>Search | Tagboard</title>
    </head>
    <body>
        {{> sidebar . }}
        <main>
            <h1>Search</h1>
            <ol>
                {{#each matching_item}}
                    <li>
                        <a href="{{ uri }}">{{ uri }}</a>
                        <br>
                        <code>{{ tags_string }}</code>
                    </li>
                {{/each}}
            </ol>
        </main>
    </body>
</html>
