<!DOCTYPE html>
<html lang="en">
    <head>
        {{> head_boilerplate . }}
        <title>Home | Tagboard</title>
    </head>
    <body id="app">
        {{> sidebar . }}
        <main>
            <h1>Tagboard</h1>
            <form action="/search">
                <label>
                    Tags:
                    <input name="tags_string" />
                </label>
                <small>(space-separated)</small>
                <br>
                <button>Search</button>
                <br>
                (Note: an empty search matches all items.)
            </form>
            <br>
            <form action="/api/item_by_uri">
                Or, get a specific item by the URI it describes:
                <br>
                <label>
                    URI:
                    <input name="uri" required>
                </label>
                <br>
                <button>Go</button>
            </form>
        </main>
    </body>
</html>
